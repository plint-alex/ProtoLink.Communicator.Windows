<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FF000000"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="SettingsOverlayBackground" Color="#FF000000"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FFA8A8A8"/>
    <SolidColorBrush x:Key="ForegroundLinkBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="BorderBrushStandard" Color="#FF262626"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FF000000"/>
    <SolidColorBrush x:Key="PanelCardBackground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="ListBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="#FF121212"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#330095F6"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#330095F6"/>
    <SolidColorBrush x:Key="IgHeaderTitleBrush" Color="#FFF5F5F5"/>

    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#FF1B2A24"/>
    <SolidColorBrush x:Key="ChatBubbleOutgoingBrush" Color="#FF005C4B"/>
    <SolidColorBrush x:Key="ChatBubbleIncomingBrush" Color="#FF2A3942"/>
    <SolidColorBrush x:Key="ChatBubbleTextBrush" Color="#FFE9EDEF"/>
    <SolidColorBrush x:Key="ChatBubbleTimeBrush" Color="#FF8696A0"/>
    <SolidColorBrush x:Key="ChatDateChipBackgroundBrush" Color="#CC182229"/>
    <SolidColorBrush x:Key="ChatDateChipForegroundBrush" Color="#FF8696A0"/>

    <SolidColorBrush x:Key="NotesToolbarBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="NotesToolbarSeparatorBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="NotesToolbarButtonHoverBrush" Color="#14FFFFFF"/>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource TabItemBackgroundBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="IgPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IgGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="IgTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStandard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>

    <Style x:Key="IgSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
        <Setter Property="Margin" Value="16,20,16,8"/>
    </Style>
</ResourceDictionary>
