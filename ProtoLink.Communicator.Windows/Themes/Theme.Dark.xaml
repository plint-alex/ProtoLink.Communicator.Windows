<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#FF252526"/>
    <SolidColorBrush x:Key="SettingsOverlayBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FF9D9D9D"/>
    <SolidColorBrush x:Key="ForegroundLinkBrush" Color="#FF569CD6"/>
    <SolidColorBrush x:Key="BorderBrushStandard" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#FF505050"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="PanelCardBackground" Color="#FF333337"/>
    <SolidColorBrush x:Key="ListBackground" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#FF6BCF7F"/>

    <!-- Messenger (Android bubble parity) -->
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#FF1B2A24"/>
    <SolidColorBrush x:Key="ChatBubbleOutgoingBrush" Color="#FF005C4B"/>
    <SolidColorBrush x:Key="ChatBubbleIncomingBrush" Color="#FF2A3942"/>
    <SolidColorBrush x:Key="ChatBubbleTextBrush" Color="#FFE9EDEF"/>
    <SolidColorBrush x:Key="ChatBubbleTimeBrush" Color="#FF8696A0"/>
    <SolidColorBrush x:Key="ChatDateChipBackgroundBrush" Color="#CC182229"/>
    <SolidColorBrush x:Key="ChatDateChipForegroundBrush" Color="#FF8696A0"/>

    <SolidColorBrush x:Key="NotesToolbarBackground" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="NotesToolbarSeparatorBrush" Color="#FF505050"/>
    <SolidColorBrush x:Key="NotesToolbarButtonHoverBrush" Color="#FF3E3E42"/>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource TabItemBackgroundBrush}"/>
    </Style>
</ResourceDictionary>
