<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Instagram-inspired light chrome -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SettingsOverlayBackground" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#FFDBDBDB"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FF8E8E8E"/>
    <SolidColorBrush x:Key="ForegroundLinkBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="BorderBrushStandard" Color="#FFDBDBDB"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFDBDBDB"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="PanelCardBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ListBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0095F6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0095F6"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#140095F6"/>
    <SolidColorBrush x:Key="IgHeaderTitleBrush" Color="#FF262626"/>

    <!-- Messenger (keep Telegram chat feel) -->
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#FFEFEAE2"/>
    <SolidColorBrush x:Key="ChatBubbleOutgoingBrush" Color="#FFDCF8C6"/>
    <SolidColorBrush x:Key="ChatBubbleIncomingBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ChatBubbleTextBrush" Color="#FF111111"/>
    <SolidColorBrush x:Key="ChatBubbleTimeBrush" Color="#FF667781"/>
    <SolidColorBrush x:Key="ChatDateChipBackgroundBrush" Color="#E6E1F0DB"/>
    <SolidColorBrush x:Key="ChatDateChipForegroundBrush" Color="#FF54656F"/>

    <!-- Notes toolbar -->
    <SolidColorBrush x:Key="NotesToolbarBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="NotesToolbarSeparatorBrush" Color="#FFDBDBDB"/>
    <SolidColorBrush x:Key="NotesToolbarButtonHoverBrush" Color="#0F000000"/>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource TabItemBackgroundBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="IgPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IgGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="IgTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStandard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ContentBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>

    <Style x:Key="IgSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
        <Setter Property="Margin" Value="16,20,16,8"/>
    </Style>
</ResourceDictionary>
