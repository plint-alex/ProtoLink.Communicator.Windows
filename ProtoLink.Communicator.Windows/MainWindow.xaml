<Window x:Class="ProtoLink.Communicator.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ProtoLink.Communicator.Windows.Views"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        mc:Ignorable="d"
        Title="ProtoLink Communicator" Height="640" Width="900"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundBrush}"
        Icon="pack://application:,,,/ProtoLink.Communicator.Windows;component/Assets/icon.png">
    <Window.Resources>
        <!-- Instagram-style top chrome: tabs + actions; Settings opens as full-width page instead of overlay -->
        <Style TargetType="TabControl" x:Key="TabControlWithSettingsButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="4,0" MinHeight="48">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TabPanel IsItemsHost="True" Grid.Column="0" Margin="4,0,0,0" VerticalAlignment="Stretch"/>
                                    <StackPanel x:Name="TabToolbarPanel" Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <Button x:Name="SettingsButtonInTemplate" Grid.Column="2" Margin="0,0,12,0"
                                            MinWidth="40" Height="36" VerticalAlignment="Center"
                                            Content="&#9881;" FontSize="18" Background="Transparent" BorderThickness="0"
                                            ToolTip="Settings" Cursor="Hand"
                                            Foreground="{DynamicResource ForegroundBrush}"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainContentRow" Height="*" MinHeight="80"/>
            <RowDefinition x:Name="DevToolsSplitterRow" Height="0"/>
            <RowDefinition x:Name="DevToolsPanelRow" Height="0" MinHeight="0"/>
        </Grid.RowDefinitions>
        <Grid x:Name="ContentGrid" Grid.Row="0" Background="{DynamicResource ContentBackground}">
            <!-- Main tabs (hidden while Settings is open) -->
            <TabControl x:Name="MainTabControl" Style="{StaticResource TabControlWithSettingsButton}" Loaded="MainTabControl_Loaded">
                <TabItem Header="Messenger">
                    <Grid x:Name="MessengerTabContent"/>
                </TabItem>
                <TabItem Header="Notes">
                    <Grid x:Name="NotesTabContent"/>
                </TabItem>
                <TabItem Header="Cloud">
                    <Grid x:Name="CloudTabContent"/>
                </TabItem>
            </TabControl>
            <!-- Settings: full-width page instead of the tab strip -->
            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource SettingsOverlayBackground}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
        <GridSplitter x:Name="DevToolsSplitter"
                      Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource SplitterBrush}"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="Collapsed"/>
        <views:DeveloperToolsPanel x:Name="DeveloperToolsHost"
                                   Grid.Row="2"
                                   Visibility="Collapsed"/>
    </Grid>
</Window>
