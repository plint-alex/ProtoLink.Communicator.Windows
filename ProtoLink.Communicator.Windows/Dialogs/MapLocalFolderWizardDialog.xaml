<Window x:Class="ProtoLink.Communicator.Windows.Dialogs.MapLocalFolderWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local folder → Cloud"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackground}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LocalLabel" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="ChangeLocalButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                    Click="OnChangeLocalClick"/>
            <TextBlock x:Name="LocalPathText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
        </DockPanel>

        <TextBlock x:Name="DestinationLabel" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3">
            <RadioButton x:Name="CreateNewRadio" GroupName="Dest" IsChecked="True"
                         Margin="0,0,0,8" Checked="OnDestModeChanged"/>
            <StackPanel Margin="24,0,0,12" IsEnabled="{Binding ElementName=CreateNewRadio, Path=IsChecked}">
                <TextBlock x:Name="FolderNameLabel" Margin="0,0,0,4"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <TextBox x:Name="FolderNameBox" Padding="8,6"/>
            </StackPanel>
            <RadioButton x:Name="PickExistingRadio" GroupName="Dest" Margin="0,0,0,8"
                         Checked="OnDestModeChanged"/>
            <ListBox x:Name="ExistingFoldersList" Height="120" Margin="24,0,0,0"
                     IsEnabled="{Binding ElementName=PickExistingRadio, Path=IsChecked}"
                     DisplayMemberPath="Name"/>
            <TextBlock x:Name="NoFoldersHint" Margin="24,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundMutedBrush}" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock x:Name="WarnText" Grid.Row="4" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,16"
                   Foreground="{DynamicResource ForegroundMutedBrush}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Padding="14,6" Margin="0,0,8,0" IsDefault="True"
                    Style="{DynamicResource PrimaryButton}" Click="OnConfirmClick"/>
            <Button x:Name="CancelButton" Padding="14,6" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
