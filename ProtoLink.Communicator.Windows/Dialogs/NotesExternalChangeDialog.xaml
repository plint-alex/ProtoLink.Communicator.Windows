<Window x:Class="ProtoLink.Communicator.Windows.Dialogs.NotesExternalChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note changed on disk" Height="Auto" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="This note was modified on disk while you have unsaved edits. Choose how to continue."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reload from disk" Click="OnReloadClick" Padding="12,6" Margin="0,0,8,0" MinWidth="120"/>
            <Button Content="Keep my edits" Click="OnKeepClick" Padding="12,6" MinWidth="120" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
