<Window x:Class="ProtoLink.Communicator.Windows.Dialogs.ErrorDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error details" Height="400" Width="600" WindowStartupLocation="CenterOwner"
        MinHeight="300" MinWidth="400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="ErrorTextBox" Grid.Row="0" Margin="0,0,0,10"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas" FontSize="12"
                 AcceptsReturn="True" VerticalContentAlignment="Top"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton" Content="Copy" Width="75" Margin="0,0,8,0" Click="OnCopyClick"/>
            <Button Content="Close" Width="75" IsCancel="True" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
