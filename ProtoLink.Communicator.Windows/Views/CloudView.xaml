<UserControl x:Class="ProtoLink.Communicator.Windows.Views.CloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ProtoLink.Communicator.Windows.Controls"
             xmlns:views="clr-namespace:ProtoLink.Communicator.Windows.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource ForegroundBrush}"
             SizeChanged="OnRootSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="CloudListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemMouseUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,4"
                                BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackground}">
        <Grid x:Name="PanesGrid">
            <!-- E9e / AT-CE16: outer shell is Tree | Main only (never three simultaneous columns). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="220" MinWidth="160" MaxWidth="360"/>
                <ColumnDefinition x:Name="TreeSplitterColumn" Width="4"/>
                <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Folders tree — full height left column (AT-CE1 / AT-CE7); collapsed when empty (E9d / AT-CE15). -->
            <Grid x:Name="TreePane" Grid.Column="0" Background="{DynamicResource ListBackground}"
                  Visibility="{Binding ShowFolderTree, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <TextBlock Text="{Binding FolderTreeHeading}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   AutomationProperties.Name="Folders tree heading"/>
                    </Border>
                    <ListBox x:Name="FolderTreeListBox" ItemsSource="{Binding FolderTreeRows}"
                             BorderThickness="0" Background="{DynamicResource ListBackground}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VerticalAlignment="Stretch"
                             MouseDoubleClick="OnFolderTreeDoubleClick"
                             PreviewMouseLeftButtonUp="OnFolderTreeItemClick"
                             AutomationProperties.Name="Cloud folders tree">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- E9c / AT-CE14: no per-row hairline (Explorer nav feel); contents list keeps CloudListBoxItemStyle separators -->
                                            <Border x:Name="Bd" Background="Transparent"
                                                    Padding="{Binding IndentMargin}"
                                                    BorderThickness="0">
                                                <DockPanel LastChildFill="True">
                                                    <!-- Fixed width so leaf rows align with expandable ones (AT-CE11). -->
                                                    <Grid DockPanel.Dock="Left" Width="18" Margin="0,0,2,0"
                                                          VerticalAlignment="Center">
                                                        <Button Width="18" Height="18" Padding="0"
                                                                FontSize="11"
                                                                Content="{Binding ExpandGlyph}"
                                                                Visibility="{Binding ShowExpandAffordance, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Command="{Binding DataContext.ToggleFolderTreeExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                PreviewMouseLeftButtonDown="OnFolderTreeExpandPreviewDown"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand"
                                                                AutomationProperties.Name="Expand or collapse folder"
                                                                ToolTip="Expand / collapse"/>
                                                    </Grid>
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding FolderGlyph}" FontSize="13"
                                                               Width="18" Margin="0,0,4,0"
                                                               VerticalAlignment="Center"
                                                               AutomationProperties.Name="Folder icon"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Grid>

            <GridSplitter x:Name="TreePaneSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushStandard}"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          AutomationProperties.Name="Resize Cloud folders tree"/>

            <!-- Main browse: empty tree = contents|info side-by-side; populated tree = stacked contents+info (E9e). -->
            <Grid x:Name="MainPanesGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="BrowseRowTop" Height="*"/>
                    <RowDefinition x:Name="BrowseRowSplitter" Height="0"/>
                    <RowDefinition x:Name="BrowseRowBottom" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="280"/>
                    <ColumnDefinition x:Name="EntitySplitterColumn" Width="4"/>
                    <ColumnDefinition x:Name="EntityColumn" Width="*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

            <!-- Contents details list (AT-CE2) -->
            <Grid x:Name="ListPane" Grid.Row="0" Grid.Column="0" Background="{DynamicResource ListBackground}"
                  Visibility="{Binding ShowListPane, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Cloud" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource HeaderTitleBrush}"/>
                        <TextBox x:Name="ListSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"
                                 Background="{DynamicResource ContentBackground}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrushStandard}"
                                 ToolTip="Search in this folder (Ctrl+F)"/>
                        <!-- E6: discoverable local-first map (AT-MAP-1) -->
                        <Button Content="{Binding AddLocalFolderCtaLabel}" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Padding="10,4"
                                Style="{DynamicResource GhostButton}"
                                Command="{Binding AddLocalFolderCommand}"
                                AutomationProperties.Name="{Binding AddLocalFolderAutomationName}"
                                Visibility="{Binding ShowAddLocalFolderCta, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Offline / status banners (UX Pattern 5; replaces permanent status bar) -->
                <StackPanel Grid.Row="1">
                    <Border Padding="12,8" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowNetworkBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Waiting for network…" FontSize="12"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                    <Border Padding="12,8" Background="{DynamicResource ToolbarBackground}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowStatusBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Details" Margin="8,0,0,0" Padding="8,2"
                                    Style="{DynamicResource GhostButton}"
                                    Command="{Binding ShowErrorDetailsCommand}"
                                    Visibility="{Binding HasErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Details column headers -->
                    <Border Grid.Row="0" Padding="10,6"
                            Background="{DynamicResource ToolbarBackground}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Type" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="Size" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="Date" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <ListBox x:Name="CloudListBox" ItemsSource="{Binding FilteredItems}" KeyDown="OnListKeyDown"
                             ScrollViewer.ScrollChanged="OnListScrollChanged"
                             SelectionChanged="OnSelectionChanged" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             BorderThickness="0" Background="{DynamicResource ListBackground}"
                             ItemContainerStyle="{StaticResource CloudListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Padding" Value="0"/>
                                <Style.Triggers>
                                    <!-- Leave room so FAB does not cover the last list rows (UX-C-F4). -->
                                    <DataTrigger Binding="{Binding ShowCreateFab}" Value="True">
                                        <Setter Property="Padding" Value="0,0,0,72"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <!-- Explorer details: Name · Type · Size · Date (+ compact sync cue) -->
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding TypeGlyph}" FontSize="14"
                                                   Width="22" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundBrush}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SyncBadgeText}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessTintBrush}"
                                               Visibility="{Binding IsSynced, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pattern 5: empty folder / Shared with me empty (UX §7) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                MaxWidth="280"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                                Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding EmptyListGlyph}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding EmptyListTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding EmptyListBody}"
                                   FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                        <Button Content="Upload" HorizontalAlignment="Center"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding UploadCommand}"
                                ToolTip="Upload files into this folder"
                                AutomationProperties.Name="Upload into empty folder"
                                Visibility="{Binding ShowEmptyUpload, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="{Binding AddLocalFolderCtaLabel}" Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Style="{DynamicResource GhostButton}"
                                Command="{Binding AddLocalFolderCommand}"
                                AutomationProperties.Name="{Binding AddLocalFolderAutomationName}"
                                Visibility="{Binding ShowAddLocalFolderCta, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Pattern 1 Create FAB (cycle1-next-polish UX-C-F1…F4); AccentBrush = #2AABEE -->
                    <Button x:Name="CreateFabButton"
                            Width="56" Height="56"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16"
                            Panel.ZIndex="2"
                            Cursor="Hand"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="OnCreateFabClick"
                            ToolTip="{Binding CreateFabToolTip}"
                            AutomationProperties.Name="{Binding CreateFabAutomationName}"
                            Visibility="{Binding ShowCreateFab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="FabBg" Fill="{TemplateBinding Background}"/>
                                    <TextBlock Text="+" FontSize="28" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" Margin="0,-2,0,0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FabBg" Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="FabBg" Property="Opacity" Value="0.84"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding CreateFabNewFolderLabel}"
                                          Command="{Binding NewFolderCommand}"/>
                                <MenuItem Header="{Binding CreateFabUploadLabel}"
                                          Command="{Binding UploadCommand}"/>
                                <MenuItem Header="{Binding AddLocalFolderCtaLabel}"
                                          Command="{Binding AddLocalFolderCommand}"
                                          Visibility="{Binding ShowAddLocalFolderCta, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter x:Name="EntityPaneSplitter" Grid.Row="0" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushStandard}"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          AutomationProperties.Name="Resize Cloud contents and info"/>

            <!-- Entity pane (info / preview) — stacked under list when Folders tree is present (E9e / AT-CE16) -->
            <Grid x:Name="EntityPane" Grid.Row="0" Grid.Column="2"
                  Visibility="{Binding ShowEntityPane, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:EntityHeader x:Name="EntityHeaderControl" Grid.Row="0"
                                       Title="{Binding HeaderTitle}"
                                       Subtitle="{Binding HeaderSubtitle}"
                                       TypeGlyph="{Binding HeaderTypeGlyph}"
                                       ShowBack="{Binding ShowBack}"
                                       BackCommand="{Binding BackCommand}"
                                       ShowShare="True"
                                       ShareButtonLabel="{Binding ShareButtonLabel}"
                                       ShareCommand="{Binding OpenShareCommand}"
                                       CopyLinkCommand="{Binding CopyLinkCommand}"
                                       NavigateParentCommand="{Binding NavigateParentCommand}"/>

                <!-- Folder info -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16"
                              Visibility="{Binding IsFolderOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Info" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding ListedChildCountText}" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <TextBlock Text="{Binding FolderSizeSummary, StringFormat=Size: {0}}" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Visibility="{Binding FolderSizeSummary, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- AT-S40: id row + Copy link (canonical URL via CopyLinkCommand) -->
                        <DockPanel Margin="0,4,0,12"
                                   Visibility="{Binding HasCurrentEntityId, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Content="Copy link" Margin="12,0,0,0"
                                    Style="{DynamicResource GhostButton}" VerticalAlignment="Center"
                                    Command="{Binding CopyLinkCommand}"
                                    AutomationProperties.Name="Copy link"
                                    ToolTip="Copy link (Ctrl+Shift+C)"/>
                            <StackPanel>
                                <TextBlock Text="Id" FontSize="12"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentEntityIdText}" FontSize="13" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           AutomationProperties.Name="Entity id"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource PanelCardBackground}"
                                BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="1"
                                Visibility="{Binding HasCurrentFolderMapping, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Synced mapping" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding CurrentFolderMappingPath}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="Sync" Margin="0,0,8,4" Style="{DynamicResource GhostButton}"
                                            Command="{Binding SyncCurrentMappingCommand}"/>
                                    <Button Content="Upload all" Margin="0,0,8,4" Style="{DynamicResource GhostButton}"
                                            Command="{Binding ForceUploadCurrentMappingCommand}"
                                            ToolTip="Overwrite server with local files"/>
                                    <Button Content="Download all" Margin="0,0,8,4" Style="{DynamicResource GhostButton}"
                                            Command="{Binding ForceDownloadCurrentMappingCommand}"
                                            ToolTip="Overwrite local files from server"/>
                                    <Button Content="Unmap" Margin="0,0,8,4" Style="{DynamicResource GhostButton}"
                                            Command="{Binding UnmapCurrentFolderCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding MapThisFolderLabel}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Style="{DynamicResource GhostButton}" Click="OnMapCurrentFolderClick"
                                Visibility="{Binding CanMapCurrentFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- AT-S42: Shared with me is browse-only (no Map / one-way sync in cycle 1) -->
                        <TextBlock Text="{Binding SharedBrowseOnlyHintText}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,12,0,0" MaxWidth="420"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   Visibility="{Binding ShowSharedBrowseOnlyHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.Name="Shared folder browse-only hint"/>

                        <Button Content="{Binding ShareButtonLabel}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Style="{DynamicResource GhostButton}"
                                Command="{Binding OpenShareCommand}"
                                AutomationProperties.Name="Share from Info"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- File preview (image / text / PDF / other) -->
                <Grid Grid.Row="1"
                      Visibility="{Binding IsFileOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Loading preview…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="13"
                               Visibility="{Binding ShowPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="420"
                                Visibility="{Binding ShowPreviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Open" Margin="0,0,8,0" Style="{DynamicResource GhostButton}"
                                    Command="{Binding OpenExternallyCommand}"/>
                            <Button Content="Download" Style="{DynamicResource GhostButton}"
                                    Command="{Binding DownloadCurrentCommand}"/>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16"
                             Background="Transparent" Foreground="{DynamicResource ForegroundBrush}"
                             FontFamily="Consolas" FontSize="13"
                             Visibility="{Binding ShowPreviewText, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <wv2:WebView2 x:Name="PdfPreviewWebView" DefaultBackgroundColor="Transparent"
                                  Visibility="{Binding ShowPreviewPdf, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding ShowPreviewOther, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="88" Height="88" CornerRadius="18" Margin="0,0,0,16"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding PreviewTypeGlyph}" FontSize="40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        <TextBlock Text="No in-app preview for this file type" FontSize="13" TextAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Open" Margin="0,0,8,0" Style="{DynamicResource GhostButton}"
                                    Command="{Binding OpenExternallyCommand}"/>
                            <Button Content="Download" Style="{DynamicResource GhostButton}"
                                    Command="{Binding DownloadCurrentCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- Share side sheet (UX §§2–3 / AT-S41) over entity pane -->
                <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right"
                        Visibility="{Binding ShareSheet.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:ShareSheetView DataContext="{Binding ShareSheet}"/>
                </Border>
            </Grid>
            </Grid><!-- MainPanesGrid -->
        </Grid>
    </Grid>
</UserControl>
