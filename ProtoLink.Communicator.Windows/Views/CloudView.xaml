<UserControl x:Class="ProtoLink.Communicator.Windows.Views.CloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource ForegroundBrush}">
    <Grid Background="{DynamicResource ContentBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ToolbarBorderBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x2190; Up" Command="{Binding UpCommand}" Padding="8,4" Margin="0,0,8,0"
                        IsEnabled="{Binding CanGoUp}"/>
                <ItemsControl ItemsSource="{Binding BreadcrumbPath}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding Name}" Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Index}" Style="{StaticResource {x:Type Button}}"
                                        Padding="4,2" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Foreground="{DynamicResource ForegroundLinkBrush}"/>
                                <TextBlock Text=" &#x203A; " VerticalAlignment="Center" Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Visibility="{Binding Index, Converter={StaticResource IndexToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ListBox x:Name="CloudListBox" ItemsSource="{Binding Items}" MouseDoubleClick="OnItemDoubleClick"
                         SelectionChanged="OnSelectionChanged" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         BorderThickness="0" Background="{DynamicResource ListBackground}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4C1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="&#x1F4C4;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text=" (synced)" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource SuccessTintBrush}"
                                           Visibility="{Binding IsSynced, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="This folder is empty. Upload files or create a new folder."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundMutedBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
            <Expander Grid.Row="1" Header="Synced folders" IsExpanded="False" Margin="4,2" VerticalAlignment="Top">
                <ItemsControl x:Name="SyncedMappingsList" ItemsSource="{Binding SyncMappings}" Margin="4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="6,4" Background="{DynamicResource PanelCardBackground}" BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CloudFolderName}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="&#x2194;" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding LocalPath}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Sync now" Margin="4,0" Padding="8,4" Tag="{Binding}" Click="OnSyncNowClick"/>
                                    <Button Grid.Column="2" Content="Unmap" Margin="4,0" Padding="8,4" Tag="{Binding}" Click="OnUnmapSyncClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBackground}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="80" Foreground="{DynamicResource ForegroundBrush}"/>
        </StatusBar>
    </Grid>
</UserControl>
