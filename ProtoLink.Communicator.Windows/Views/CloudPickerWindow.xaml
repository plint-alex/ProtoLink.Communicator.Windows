<Window x:Class="ProtoLink.Communicator.Windows.Views.CloudPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520" Height="560"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBackground}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28"
                    Command="{Binding CloseCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button DockPanel.Dock="Left" Content="←" Width="32" Height="28" Margin="0,0,6,0"
                    Command="{Binding GoBackCommand}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource ForegroundBrush}"
                    ToolTip="Back"/>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12"
                           Foreground="{DynamicResource ChatBubbleTimeBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <TextBox Grid.Row="1" Margin="0,0,0,8" Padding="8,6"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{DynamicResource AppTextBox}"
                 Tag="Search in folder…"/>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Items}"
                     Background="{DynamicResource ListBackground}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Opacity" Value="{Binding RowOpacity}"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,8">
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8"
                                    Background="#22000000" Margin="0,0,12,0">
                                <TextBlock Text="{Binding TypeGlyph}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="16" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ChatBubbleTimeBrush}"
                                       Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{DynamicResource ChatBubbleTimeBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource ChatBubbleTimeBrush}"
                       Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}"/>
            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource ChatBubbleTimeBrush}"
                   Text="Single-click a file to attach. Folders open on click."/>
    </Grid>
</Window>
