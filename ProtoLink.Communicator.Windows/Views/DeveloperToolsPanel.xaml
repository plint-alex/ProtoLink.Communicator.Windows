<UserControl x:Class="ProtoLink.Communicator.Windows.Views.DeveloperToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="800"
             Background="#1e1e1e">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="DetailHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9cdcfe"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Developer tools" Foreground="#cccccc" VerticalAlignment="Center" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ClearConsoleButton" Content="Clear console" Padding="10,2" Margin="0,0,6,0"
                            Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555" Cursor="Hand"/>
                    <Button x:Name="ClearNetworkButton" Content="Clear network" Padding="10,2" Margin="0,0,6,0"
                            Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Content="Close" Padding="10,2"
                            Background="#3c3c3c" Foreground="#e0e0e0" BorderBrush="#555" Cursor="Hand"
                            ToolTip="Close (F12)"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Background="#1e1e1e" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#cccccc"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Background" Value="#2d2d30"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Console">
                <ListBox x:Name="ConsoleList"
                         Background="#1e1e1e"
                         Foreground="#d4d4d4"
                         BorderThickness="0"
                         FontFamily="Consolas,Cascadia Mono"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"/>
            </TabItem>
            <TabItem Header="Network">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="48"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="NetworkGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Background="#1e1e1e"
                              Foreground="#d4d4d4"
                              RowBackground="#1e1e1e"
                              AlternatingRowBackground="#252526"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#333"
                              BorderThickness="0"
                              FontFamily="Consolas,Cascadia Mono"
                              FontSize="11"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="90"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="60"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="56"/>
                            <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="48"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#505050"
                                  ShowsPreview="True"
                                  ResizeBehavior="PreviousAndNext"/>
                    <Grid Grid.Row="2" Margin="4,0,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Payload row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Request payload" Style="{StaticResource DetailHeader}"/>
                                <TextBox x:Name="RequestPayloadBox"
                                         Background="#252526"
                                         Foreground="#ce9178"
                                         BorderBrush="#3f3f46"
                                         FontFamily="Consolas,Cascadia Mono"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"/>
                            </DockPanel>
                            <GridSplitter Grid.Column="1"
                                          Width="5"
                                          HorizontalAlignment="Stretch"
                                          Background="#505050"
                                          ShowsPreview="True"
                                          ResizeDirection="Columns"/>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Response body" Style="{StaticResource DetailHeader}"/>
                                <TextBox x:Name="ResponseBodyBox"
                                         Background="#252526"
                                         Foreground="#b5cea8"
                                         BorderBrush="#3f3f46"
                                         FontFamily="Consolas,Cascadia Mono"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"/>
                            </DockPanel>
                        </Grid>
                        <GridSplitter Grid.Row="1"
                                      Height="5"
                                      HorizontalAlignment="Stretch"
                                      Background="#505050"
                                      ShowsPreview="True"
                                      ResizeBehavior="PreviousAndNext"/>
                        <!-- Headers row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Request headers" Style="{StaticResource DetailHeader}"/>
                                <TextBox x:Name="RequestHeadersBox"
                                         Background="#252526"
                                         Foreground="#dcdcaa"
                                         BorderBrush="#3f3f46"
                                         FontFamily="Consolas,Cascadia Mono"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"/>
                            </DockPanel>
                            <GridSplitter Grid.Column="1"
                                          Width="5"
                                          HorizontalAlignment="Stretch"
                                          Background="#505050"
                                          ShowsPreview="True"
                                          ResizeDirection="Columns"/>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Response headers" Style="{StaticResource DetailHeader}"/>
                                <TextBox x:Name="ResponseHeadersBox"
                                         Background="#252526"
                                         Foreground="#c586c0"
                                         BorderBrush="#3f3f46"
                                         FontFamily="Consolas,Cascadia Mono"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
