<UserControl x:Class="ProtoLink.Communicator.Windows.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:ProtoLink.Communicator.Windows.Views"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource ForegroundBrush}"
             SizeChanged="OnRootSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="NotesToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Keyboard focus must stay in the WebView: a focused WPF button swallows typing and Ctrl+Z. -->
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotesToolbarButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackground}">
    <Grid Background="{DynamicResource ContentBackground}" x:Name="PanesGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="280" MaxWidth="420"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
            <ColumnDefinition x:Name="EditorColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Notes list -->
        <Grid x:Name="TreePane" Grid.Column="0" Background="{DynamicResource ListBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <TextBlock Text="Notes" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderTitleBrush}"/>
            </Border>
            <!-- E6: Notes root not under any Cloud mapping (AT-MAP-4); no sync chrome -->
            <Border Grid.Row="1" Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowMapToCloudNudge, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{Binding MapToCloudNudgeText}"
                        HorizontalAlignment="Left" Padding="0"
                        Style="{DynamicResource GhostButton}"
                        Command="{Binding AddNotesRootToCloudCommand}"
                        AutomationProperties.Name="{Binding MapToCloudNudgeText}"/>
            </Border>
            <Grid Grid.Row="2">
                <TreeView x:Name="NotesTreeView" SelectedItemChanged="OnTreeSelectionChanged"
                          Background="{DynamicResource ListBackground}" BorderThickness="0"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnTreePreviewMouseMove"
                          DragOver="OnTreeDragOver"
                          Drop="OnTreeDrop"
                          MouseDoubleClick="OnTreeDoubleClick" ContextMenuOpening="OnNotesTreeContextMenuOpening"
                          Padding="0,4"
                          TreeViewItem.Expanded="OnTreeItemExpanded"
                          TreeViewItem.Collapsed="OnTreeItemCollapsed"
                          Visibility="{Binding ShowNotesTree, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="NotesTreeContextMenu">
                            <MenuItem Header="New Page" Click="OnNewPageClick"/>
                            <Separator/>
                            <MenuItem x:Name="NotesTreeOpenInExplorerMenuItem" Header="Open in Explorer" Click="OnOpenInExplorerClick"/>
                            <MenuItem x:Name="NotesTreeCopyLinkMenuItem" Header="Copy link" Click="OnCopyLinkClick"/>
                            <MenuItem x:Name="NotesTreeShareMenuItem" Header="Share…" Click="OnShareClick"/>
                            <MenuItem x:Name="NotesTreeOpenInBrowserMenuItem" Header="Open in browser" Click="OnOpenInBrowserClick"/>
                            <MenuItem x:Name="NotesTreeCopyIdMenuItem" Header="Copy id" Click="OnCopyIdClick"/>
                            <Separator/>
                            <MenuItem Header="Rename" Click="OnRenameFolderClick"/>
                            <MenuItem Header="Delete" Click="OnDeleteFolderClick"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <!-- Unset / missing Notes root — not the same as “no notes yet” -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            MaxWidth="300"
                            Visibility="{Binding NeedsNotesRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                            Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose a Notes folder" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Notes stay on your PC. Pick the folder that holds your note pages (each page is a folder with index.html). You can change this later in Settings."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <Button Content="Choose Notes folder" HorizontalAlignment="Center"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding ChooseNotesRootCommand}"
                            ToolTip="Select the local folder for Notes"
                            AutomationProperties.Name="Choose Notes folder"/>
                </StackPanel>

                <!-- Pattern 5: first-run Notes (root set, no child pages) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            MaxWidth="280"
                            Visibility="{Binding IsNotesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                            Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No notes yet" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Notes are local pages you can sync to Cloud later."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <Button Content="Create first note" HorizontalAlignment="Center"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding CreateFirstNoteCommand}"
                            ToolTip="Create your first note page"
                            AutomationProperties.Name="Create first note"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushStandard}"
                      ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

        <!-- Editor pane: no permanent format strip (Pattern 2 floating bar on selection) -->
        <Grid x:Name="EditorPane" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="SiblingSplitterRow" Height="0"/>
                <RowDefinition x:Name="SiblingPanelRow" Height="0" MinHeight="0" MaxHeight="320"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ClipToBounds does not clip WebView2 HWND; layout sync is in ApplySiblingPanelLayout. -->
            <Grid x:Name="EditorHost" Grid.Row="0" ClipToBounds="True">
                <wv2:WebView2 x:Name="NotesWebView"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Popup x:Name="FormatBarPopup"
                       PlacementTarget="{Binding ElementName=EditorHost}"
                       Placement="Relative"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Focusable="False"
                       IsOpen="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource NotesToolbarBackground}"
                            BorderBrush="{DynamicResource NotesToolbarSeparatorBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Direction="270"/>
                        </Border.Effect>
                        <StackPanel x:Name="FormatBarPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FormatBoldButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatBold"
                                    ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button x:Name="FormatItalicButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatItalic"
                                    ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
                                <TextBlock Text="I" FontStyle="Italic" FontSize="14"/>
                            </Button>
                            <Button x:Name="FormatUnderlineButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatUnderline"
                                    ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline">
                                <TextBlock Text="U" TextDecorations="Underline" FontSize="14"/>
                            </Button>
                            <Button x:Name="FormatStrikeButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatStrikethrough"
                                    ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough">
                                <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14"/>
                            </Button>
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                            <ComboBox x:Name="HeadingCombo" Width="110" Height="32" Margin="2,0"
                                      SelectionChanged="OnHeadingComboSelectionChanged" ToolTip="Text style"
                                      AutomationProperties.Name="Text style">
                                <ComboBoxItem x:Name="HeadingNormalItem" Content="Normal" Tag=""/>
                                <ComboBoxItem x:Name="Heading1Item" Content="Heading 1" Tag="h1"/>
                                <ComboBoxItem x:Name="Heading2Item" Content="Heading 2" Tag="h2"/>
                                <ComboBoxItem x:Name="Heading3Item" Content="Heading 3" Tag="h3"/>
                            </ComboBox>
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                            <Button x:Name="FormatBulletButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatBulletList"
                                    ToolTip="Bullet list" AutomationProperties.Name="Bullet list">
                                <TextBlock Text="•" FontSize="16" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="FormatNumberedButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatNumberedList"
                                    ToolTip="Numbered list" AutomationProperties.Name="Numbered list">
                                <TextBlock Text="1." FontSize="12" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="FormatCheckboxButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatCheckboxList"
                                    ToolTip="Checkbox list" AutomationProperties.Name="Checkbox list">
                                <TextBlock Text="☐" FontSize="14" TextAlignment="Center"/>
                            </Button>
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                            <Button x:Name="FormatLinkButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatInsertLink"
                                    ToolTip="Insert link" AutomationProperties.Name="Insert link">
                                <TextBlock Text="Link" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button x:Name="FormatCodeButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatCode"
                                    ToolTip="Code block" AutomationProperties.Name="Code block">
                                <TextBlock Text="&lt;/&gt;" FontSize="12" FontFamily="Consolas"/>
                            </Button>
                            <Button x:Name="FormatTableButton" Style="{StaticResource NotesToolbarButton}" Click="OnFormatTable"
                                    ToolTip="Insert table" AutomationProperties.Name="Insert table">
                                <TextBlock Text="Table" FontSize="10" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Spacer rows reserve editor space; panel UI is a Popup (own HWND) so WebView2 airspace cannot cover it. -->
            <GridSplitter x:Name="SiblingSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushStandard}"
                          ResizeDirection="Rows" ShowsPreview="True"
                          Visibility="Collapsed"/>
            <Border x:Name="SiblingPanelSpacer" Grid.Row="2" Background="{DynamicResource ListBackground}"
                    BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed"/>
            <!-- E5 Folder files: Popup hosts the real chrome above WebView2 HWND (AT-N7 airspace fix). -->
            <Popup x:Name="SiblingFilesPopup"
                   PlacementTarget="{Binding ElementName=SiblingPanelSpacer}"
                   Placement="Relative"
                   HorizontalOffset="0" VerticalOffset="0"
                   AllowsTransparency="False"
                   StaysOpen="True"
                   Focusable="False"
                   IsOpen="False">
                <Border x:Name="SiblingPanel"
                        Width="{Binding ActualWidth, ElementName=SiblingPanelSpacer}"
                        Height="{Binding ActualHeight, ElementName=SiblingPanelSpacer}"
                        Background="{DynamicResource ListBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1,0,0"
                        AutomationProperties.Name="Folder files">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                            <TextBlock Text="Folder files" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeaderTitleBrush}"
                                       AutomationProperties.Name="Folder files"/>
                        </Border>
                        <TreeView x:Name="SiblingFilesTreeView" Grid.Row="1"
                                  ItemsSource="{Binding SiblingFiles}"
                                  Background="{DynamicResource ListBackground}" BorderThickness="0"
                                  Padding="0,2" FontSize="13"
                                  MouseDoubleClick="OnSiblingTreeDoubleClick"
                                  ContextMenuOpening="OnSiblingTreeContextMenuOpening">
                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ContextMenu>
                                <ContextMenu x:Name="SiblingTreeContextMenu">
                                    <MenuItem x:Name="SiblingOpenMenuItem" Header="Open" Click="OnSiblingOpenClick"/>
                                    <MenuItem x:Name="SiblingOpenInExplorerMenuItem" Header="Open in Explorer" Click="OnSiblingOpenInExplorerClick"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>
            </Popup>

            <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}"
                    BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>

        <!-- Notes tree Share sheet (AC-NS-2 / AT-S48): Popup HWND above WebView2 airspace (same pattern as Folder files). -->
        <Popup x:Name="NotesShareSheetPopup"
               PlacementTarget="{Binding ElementName=PanesGrid}"
               Placement="Relative"
               AllowsTransparency="False"
               StaysOpen="True"
               Focusable="False"
               IsOpen="False">
            <Border x:Name="NotesShareSheetHost"
                    Width="360"
                    Background="{DynamicResource ContentBackground}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}"
                    BorderThickness="1,0,0,0"
                    AutomationProperties.Name="Share sheet">
                <views:ShareSheetView x:Name="NotesShareSheetView"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
