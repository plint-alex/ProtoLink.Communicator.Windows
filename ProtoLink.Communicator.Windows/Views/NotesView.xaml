<UserControl x:Class="ProtoLink.Communicator.Windows.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:controls="clr-namespace:ProtoLink.Communicator.Windows.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource ForegroundBrush}"
             SizeChanged="OnRootSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown" PreviewMouseDown="OnPreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="NotesToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Keyboard focus must stay in the WebView: a focused WPF button swallows typing and Ctrl+Z. -->
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotesToolbarButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackground}" x:Name="PanesGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="280" MaxWidth="420"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
            <ColumnDefinition x:Name="EditorColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Notes list -->
        <Grid x:Name="TreePane" Grid.Column="0" Background="{DynamicResource ListBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <TextBlock Text="Notes" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderTitleBrush}"/>
            </Border>
            <Grid Grid.Row="1">
                <TreeView x:Name="NotesTreeView" SelectedItemChanged="OnTreeSelectionChanged"
                          Background="{DynamicResource ListBackground}" BorderThickness="0"
                          MouseDoubleClick="OnTreeDoubleClick" ContextMenuOpening="OnNotesTreeContextMenuOpening"
                          Padding="0,4"
                          TreeViewItem.Expanded="OnTreeItemExpanded"
                          TreeViewItem.Collapsed="OnTreeItemCollapsed"
                          Visibility="{Binding ShowNotesTree, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="NotesTreeContextMenu">
                            <MenuItem Header="New Page" Click="OnNewPageClick"/>
                            <Separator/>
                            <MenuItem Header="Rename" Click="OnRenameFolderClick"/>
                            <MenuItem Header="Delete" Click="OnDeleteFolderClick"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <!-- Unset / missing Notes root — not the same as “no notes yet” -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            MaxWidth="300"
                            Visibility="{Binding NeedsNotesRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                            Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose a Notes folder" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Notes stay on your PC. Pick the folder that holds your note pages (each page is a folder with index.html). You can change this later in Settings."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <Button Content="Choose Notes folder" HorizontalAlignment="Center"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding ChooseNotesRootCommand}"
                            ToolTip="Select the local folder for Notes"
                            AutomationProperties.Name="Choose Notes folder"/>
                </StackPanel>

                <!-- Pattern 5: first-run Notes (root set, no child pages) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            MaxWidth="280"
                            Visibility="{Binding IsNotesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16"
                            Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No notes yet" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Notes are local pages you can sync to Cloud later."
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <Button Content="Create first note" HorizontalAlignment="Center"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding CreateFirstNoteCommand}"
                            ToolTip="Create your first note page"
                            AutomationProperties.Name="Create first note"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrushStandard}"
                      ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

        <!-- Editor pane -->
        <Grid x:Name="EditorPane" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:EntityHeader x:Name="EntityHeaderControl" Grid.Row="0"
                                   Title="{Binding HeaderTitle}"
                                   Subtitle="{Binding HeaderSubtitle}"
                                   TypeGlyph="📝"
                                   ShowBack="{Binding ShowBack}"
                                   BackCommand="{Binding BackCommand}"
                                   CopyLinkCommand="{Binding CopyLinkCommand}"
                                   CopyLinkToolTip="{Binding CopyLinkToolTip}"
                                   NavigateParentCommand="{Binding NavigateParentCommand}"/>

            <Border Grid.Row="1" Background="{DynamicResource NotesToolbarBackground}" Padding="8,6"
                    BorderBrush="{DynamicResource NotesToolbarSeparatorBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding HasOpenPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatBold"
                            ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatItalic"
                            ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatUnderline"
                            ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatStrikethrough"
                            ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                    <ComboBox x:Name="HeadingCombo" Width="110" Height="32" Margin="2,0"
                              SelectionChanged="OnHeadingComboSelectionChanged" ToolTip="Text style"
                              AutomationProperties.Name="Text style">
                        <ComboBoxItem Content="Normal" Tag=""/>
                        <ComboBoxItem Content="Heading 1" Tag="h1"/>
                        <ComboBoxItem Content="Heading 2" Tag="h2"/>
                        <ComboBoxItem Content="Heading 3" Tag="h3"/>
                    </ComboBox>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatBulletList"
                            ToolTip="Bullet list" AutomationProperties.Name="Bullet list">
                        <TextBlock Text="•" FontSize="16" TextAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatNumberedList"
                            ToolTip="Numbered list" AutomationProperties.Name="Numbered list">
                        <TextBlock Text="1." FontSize="12" TextAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatCheckboxList"
                            ToolTip="Checkbox list" AutomationProperties.Name="Checkbox list">
                        <TextBlock Text="☐" FontSize="14" TextAlignment="Center"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource NotesToolbarSeparatorBrush}" Margin="8,0"/>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatInsertLink"
                            ToolTip="Insert link" AutomationProperties.Name="Insert link">
                        <TextBlock Text="Link" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatCode"
                            ToolTip="Code block" AutomationProperties.Name="Code block">
                        <TextBlock Text="&lt;/&gt;" FontSize="12" FontFamily="Consolas"/>
                    </Button>
                    <Button Style="{StaticResource NotesToolbarButton}" Click="OnFormatTable"
                            ToolTip="Insert table" AutomationProperties.Name="Insert table">
                        <TextBlock Text="Table" FontSize="10" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>
            <wv2:WebView2 x:Name="NotesWebView" Grid.Row="2"/>
            <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}"
                    BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1,0,0" Padding="16,8">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
