<UserControl x:Class="ProtoLink.Communicator.Windows.Views.AuthFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="420"
             Foreground="{DynamicResource ForegroundBrush}"
             Background="{DynamicResource WindowBackground}">
    <Grid>
        <Border MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="24" Padding="28,32"
                Background="{DynamicResource PanelCardBackground}"
                BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <Button Content="← Back" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                        Style="{DynamicResource IgGhostButton}" Margin="0,0,0,12"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Welcome -->
                <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="ProtoLink" FontSize="32" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,8"/>
                    <TextBlock Text="Start messaging with people on ProtoLink."
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,28"/>
                    <Button Content="Start messaging" Command="{Binding StartMessagingCommand}"
                            Style="{DynamicResource IgPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <Button Content="I already have an account" Command="{Binding HaveAccountCommand}"
                            Style="{DynamicResource IgGhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <Button Content="Server settings" Command="{Binding OpenSettingsCommand}"
                            Style="{DynamicResource IgGhostButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Visibility="{Binding IsEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Your email" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="We'll send a confirmation link to this address."
                               TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource IgTextBox}" Margin="0,0,0,16"/>
                    <Button Content="Next" Command="{Binding EmailNextCommand}" IsDefault="True"
                            Style="{DynamicResource IgPrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Visibility="{Binding IsPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Create a password" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Email}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Password" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    <PasswordBox x:Name="RegisterPasswordBox" Margin="0,0,0,12" Padding="12,10" Height="40"
                                 PasswordChanged="RegisterPasswordBox_PasswordChanged"/>
                    <TextBlock Text="Confirm password" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,16" Padding="12,10" Height="40"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <Button Content="Create account" Command="{Binding PasswordNextCommand}" IsDefault="True"
                            Style="{DynamicResource IgPrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Check email -->
                <StackPanel Visibility="{Binding IsCheckEmail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Check your email" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               Text="{Binding Email, StringFormat='We sent a confirmation link to {0}. Open the link, then continue to log in.'}"/>
                    <Button Content="Resend email" Command="{Binding ResendCommand}"
                            Style="{DynamicResource IgGhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                    <Button Content="Continue to log in" Command="{Binding ContinueToLoginCommand}"
                            Style="{DynamicResource IgPrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel Visibility="{Binding IsLogin, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Log in" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Email" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource IgTextBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="Password" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    <PasswordBox x:Name="LoginPasswordBox" Margin="0,0,0,16" Padding="12,10" Height="40"
                                 PasswordChanged="LoginPasswordBox_PasswordChanged"/>
                    <Button Content="Log in" Command="{Binding LoginCommand}" IsDefault="True"
                            Style="{DynamicResource IgPrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFED4956" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
