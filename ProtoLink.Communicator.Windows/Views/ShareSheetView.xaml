<UserControl x:Class="ProtoLink.Communicator.Windows.Views.ShareSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="360"
             Foreground="{DynamicResource ForegroundBrush}">
    <Border Background="{DynamicResource ContentBackground}"
            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1,0,0,0"
            Width="360" MinWidth="320" MaxWidth="380">
        <DockPanel LastChildFill="True">
            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="16,12"
                    Background="{DynamicResource ToolbarBackground}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28"
                            Style="{DynamicResource GhostButton}"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="Close share sheet"/>
                    <StackPanel>
                        <TextBlock Text="{Binding TitleText}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding SubtitleText}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Offline banner -->
            <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding ShowOfflineBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding OfflineBannerText}" FontSize="12"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </Border>

            <!-- Error -->
            <Border DockPanel.Dock="Top" Padding="12,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorText}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>
                    <!-- LINK -->
                    <TextBlock Text="{Binding LinkSectionLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="{Binding CopyLinkLabel}"
                                Style="{DynamicResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding CopyCanonicalLinkCommand}"
                                AutomationProperties.Name="Copy canonical link"/>
                        <TextBlock Text="{Binding LinkHelperText}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                    </DockPanel>

                    <!-- GUEST LINKS -->
                    <TextBlock Text="{Binding GuestLinksSectionLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding GuestLinksHelperText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SubtreeLineText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,8"
                               Visibility="{Binding ShowSubtreeLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="…" FontSize="13" Margin="0,0,0,8"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>

                    <TextBlock Text="{Binding NoGuestLinksText}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding ShowEmptyGuestLinks, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>

                    <ItemsControl ItemsSource="{Binding LiveLinks}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="{DynamicResource PanelCardBackground}"
                                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding ShowNormalRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding TitleLine}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ExpiryLine}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                            <TextBlock Text="{Binding UsageLine}" FontSize="12"
                                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="{Binding TurnOffLabel}"
                                                        Style="{DynamicResource GhostButton}"
                                                        Command="{Binding TurnOffCommand}"
                                                        ToolTip="{Binding DataContext.MutationTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <TextBlock Text="{Binding CreatedByLine}" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ConfirmTurnOff, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding TurnOffConfirmText}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="{Binding CancelLabel}" Margin="0,0,8,0"
                                                        Style="{DynamicResource GhostButton}"
                                                        Command="{Binding CancelTurnOffCommand}"/>
                                                <Button Content="{Binding TurnOffLabel}"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        Command="{Binding TurnOffCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Create form -->
                    <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource PanelCardBackground}"
                            BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="1"
                            Visibility="{Binding ShowCreateForm, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding NameOptionalLabel}" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <TextBox Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10"
                                     Background="{DynamicResource ContentBackground}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushStandard}"/>
                            <TextBlock Text="{Binding ExpiresLabel}" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <ToggleButton Content="{Binding Expiry1Label}" Margin="0,0,6,4" Padding="8,4"
                                              IsChecked="{Binding IsExpiry1}" Style="{DynamicResource GhostButton}"/>
                                <ToggleButton Content="{Binding Expiry7Label}" Margin="0,0,6,4" Padding="8,4"
                                              IsChecked="{Binding IsExpiry7}" Style="{DynamicResource GhostButton}"/>
                                <ToggleButton Content="{Binding Expiry30Label}" Margin="0,0,6,4" Padding="8,4"
                                              IsChecked="{Binding IsExpiry30}" Style="{DynamicResource GhostButton}"/>
                                <ToggleButton Content="{Binding ExpiryNeverLabel}" Margin="0,0,6,4" Padding="8,4"
                                              IsChecked="{Binding IsExpiryNever}" Style="{DynamicResource GhostButton}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding NeverExpiresHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding ShowNeverHint, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding CancelLabel}" Margin="0,0,8,0"
                                        Style="{DynamicResource GhostButton}"
                                        Command="{Binding CancelCreateCommand}"/>
                                <Button Content="{Binding CreateLinkLabel}"
                                        Style="{DynamicResource PrimaryButton}"
                                        Command="{Binding CreateLinkCommand}"
                                        AutomationProperties.Name="Create guest link"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Create-once panel -->
                    <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding ShowCreatedPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding GuestLinkCreatedLabel}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CreatedUrl}" IsReadOnly="True" TextWrapping="Wrap"
                                     Padding="8,6" Margin="0,0,0,8"
                                     Background="{DynamicResource ContentBackground}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrushStandard}"
                                     AutomationProperties.Name="Guest link URL"/>
                            <Button Content="{Binding CopyCreatedButtonLabel}" HorizontalAlignment="Stretch"
                                    Style="{DynamicResource PrimaryButton}" Margin="0,0,0,6"
                                    Command="{Binding CopyCreatedUrlCommand}"
                                    AutomationProperties.Name="Copy guest link"/>
                            <Button Content="{Binding SendInMessengerLabel}" HorizontalAlignment="Stretch"
                                    Style="{DynamicResource GhostButton}" Margin="0,0,0,8"
                                    Command="{Binding SendCreatedInMessengerCommand}"/>
                            <TextBlock Text="{Binding CopyOnceHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <TextBlock Text="{Binding LostLinkHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"/>
                            <StackPanel Visibility="{Binding ShowCloseWithoutCopy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CloseWithoutCopyText}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding CopyAndCloseLabel}" Margin="0,0,8,0"
                                            Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding CopyAndCloseCommand}"/>
                                    <Button Content="{Binding CloseAnywayLabel}"
                                            Style="{DynamicResource GhostButton}"
                                            Command="{Binding CloseAnywayCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="{Binding DoneLabel}" HorizontalAlignment="Right"
                                    Style="{DynamicResource GhostButton}"
                                    Command="{Binding DoneCreatedCommand}"
                                    Visibility="{Binding ShowCloseWithoutCopy, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="{Binding CreateGuestLinkLabel}" HorizontalAlignment="Left"
                            Style="{DynamicResource GhostButton}" Margin="0,0,0,8"
                            Command="{Binding BeginCreateCommand}"
                            ToolTip="{Binding MutationTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding ShowCreateButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="Create guest link"/>

                    <TextBlock Text="{Binding LinkLimitText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ShowLinkLimit, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>

                    <Button Content="{Binding InactiveLinksLabel}" HorizontalAlignment="Left"
                            Style="{DynamicResource GhostButton}" Margin="0,0,0,8"
                            Command="{Binding ToggleInactiveCommand}"
                            Visibility="{Binding HasInactiveLinks, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding InactiveLinks}" Margin="0,0,0,12"
                                  Visibility="{Binding ShowInactiveList, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" Opacity="0.7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TitleLine}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ExpiryLine}" FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- PEOPLE -->
                    <TextBlock Text="{Binding PeopleSectionLabel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding People}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="24"
                                            Style="{DynamicResource GhostButton}"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip="{Binding DataContext.MutationTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding IsCreator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AccessLabel}" FontSize="12"
                                               Margin="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CreatorHint}" FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Visibility="{Binding CreatorHint, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding FooterLagText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ViewerFooterText}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding ShowViewerFooter, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource ForegroundMutedBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
