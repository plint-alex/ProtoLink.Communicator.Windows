<UserControl x:Class="ProtoLink.Communicator.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:ProtoLink.Communicator.Windows.Views"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="900"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{DynamicResource SettingsOverlayBackground}">
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Instagram-style sticky header -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Command="{Binding CloseCommand}"
                        Content="←" Width="40" Height="36" FontSize="18"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource ForegroundBrush}" ToolTip="Back"/>
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource IgHeaderTitleBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,0,32">

                <TextBlock Text="ABOUT" Style="{DynamicResource IgSectionTitle}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1">
                    <StackPanel>
                        <DockPanel Margin="16,14">
                            <TextBlock Text="App version" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrushStandard}" Margin="16,0,0,0"/>
                        <DockPanel Margin="16,14">
                            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshApiVersionCommand}"
                                    Style="{DynamicResource IgGhostButton}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="API version" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding ApiVersionText}" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="APPEARANCE" Style="{DynamicResource IgSectionTitle}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1">
                    <DockPanel Margin="16,12">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                  MinWidth="140" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <TextBlock Text="API" Style="{DynamicResource IgSectionTitle}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="API base address" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <TextBox Text="{Binding ApiBaseAddress, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource IgTextBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="Public site (Cloud → Open in browser)" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <TextBox Text="{Binding PublicSiteBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource IgTextBox}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="NOTES" Style="{DynamicResource IgSectionTitle}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Notes root folder" Margin="0,0,0,6" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NotesRootPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource IgTextBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse" Click="OnNotesBrowseClick"
                                    Style="{DynamicResource IgGhostButton}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="Save settings" Command="{Binding SaveCommand}"
                        Style="{DynamicResource IgPrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="16,20,16,0"/>

                <TextBlock Text="ACCOUNT" Style="{DynamicResource IgSectionTitle}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1" Padding="16,14"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Log off" Command="{Binding LogOffCommand}"
                                Style="{DynamicResource IgGhostButton}"/>
                        <TextBlock Text="{Binding CurrentLogin, StringFormat='Logged in as {0}'}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    </DockPanel>
                </Border>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1" Padding="16,14"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <views:LoginView DataContext="{Binding LoginViewModel}"/>
                </Border>

                <TextBlock Text="CONTACTS" Style="{DynamicResource IgSectionTitle}"
                           Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Border Background="{DynamicResource PanelCardBackground}"
                        BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1" Padding="16,14"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <views:AddContactView DataContext="{Binding AddContactViewModel}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
