<UserControl x:Class="ProtoLink.Communicator.Windows.Views.MessengerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Foreground="{DynamicResource ForegroundBrush}"
             SizeChanged="OnRootSizeChanged">
    <UserControl.Resources>
        <Style x:Key="ChatListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContactListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#142AABEE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1A2AABEE"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContactsColumn" Width="280"/>
            <ColumnDefinition x:Name="ChatColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Contacts / chats list -->
        <Grid x:Name="ContactsPane" Grid.Column="0"
              Visibility="{Binding ShowContactsPane, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,0,0,1"
                    Padding="12,10" Background="{DynamicResource ToolbarBackground}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,4"
                            Command="{Binding RefreshContactsCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Chats" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </DockPanel>
            </Border>
            <ListBox x:Name="ContactsList"
                     Grid.Row="1"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Background="{DynamicResource ListBackground}"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ContactListBoxItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding PlacementTarget.DataContext.ContactInformationLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.DataContext.OpenContactInformationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  AutomationProperties.Name="Contact information"/>
                        <MenuItem Header="{Binding PlacementTarget.DataContext.CopyContactIdLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.DataContext.CopyContactIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  AutomationProperties.Name="Copy contact id"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"
                                    Background="#FF5B8DEE" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Initial}" Foreground="White"
                                           FontWeight="SemiBold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <Border DockPanel.Dock="Right" MinWidth="20" Height="20" CornerRadius="10"
                                        Background="#FFE53935" Padding="5,0" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding UnreadLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundBrush}"/>
                            </DockPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Chat pane -->
        <Grid x:Name="ChatPane" Grid.Column="1"
              Visibility="{Binding ShowChatPane, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF527998" Padding="4,8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Content="←" Width="36" Height="36" Margin="4,0,4,0"
                            FontSize="16" Background="Transparent" BorderThickness="0"
                            Foreground="White" Cursor="Hand"
                            Command="{Binding BackToContactsCommand}"
                            Visibility="{Binding ShowChatBackButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Back to chats"/>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18"
                            Background="#FF4FAE4E" Margin="4,0,10,0"
                            Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedContact.Initial}" Foreground="White"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Media" Padding="10,4" Margin="0,0,8,0"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            Command="{Binding OpenMediaGalleryCommand}"
                            Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="Media in this chat"/>
                    <Button DockPanel.Dock="Right"
                            Content="{Binding CopyContactIdLabel}"
                            Padding="10,4" Margin="0,0,4,0"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            Command="{Binding CopyContactIdCommand}"
                            Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="{Binding CopyContactIdLabel}"
                            AutomationProperties.Name="Copy contact id"/>
                    <Button DockPanel.Dock="Right"
                            Content="{Binding ContactInformationLabel}"
                            Padding="10,4" Margin="0,0,4,0"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            Command="{Binding OpenContactInformationCommand}"
                            Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}"
                            ToolTip="{Binding ContactInformationLabel}"
                            AutomationProperties.Name="Contact information"/>
                    <StackPanel VerticalAlignment="Center" Margin="4,0,8,0">
                        <TextBlock Text="{Binding ChatHeaderTitle}" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="#CCFFFFFF" FontSize="11"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" AllowDrop="True"
                  PreviewDragEnter="OnChatDragEnter" PreviewDragOver="OnChatDragOver"
                  PreviewDragLeave="OnChatDragLeave" Drop="OnChatDrop">
                <ListBox x:Name="MessagesList"
                         ItemsSource="{Binding Messages}"
                         Background="{DynamicResource ChatBackgroundBrush}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="OnMessagesScrollChanged"
                         ItemContainerStyle="{StaticResource ChatListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Date chip (Today / Yesterday / d MMMM yyyy), Android parity -->
                                <Border HorizontalAlignment="Center"
                                        Margin="0,8,0,4"
                                        Padding="12,4"
                                        CornerRadius="12"
                                        Background="{DynamicResource ChatDateChipBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDateSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DayLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ChatDateChipForegroundBrush}"/>
                                </Border>

                                <!-- Message bubble -->
                                <Grid Margin="4,2" MaxWidth="520">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="4,2,56,2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDateSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFromMe}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Margin" Value="56,2,4,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border CornerRadius="12" Padding="10,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ChatBubbleIncomingBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFromMe}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ChatBubbleOutgoingBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Opacity>
                                            <Binding Path="BubbleOpacity"/>
                                        </Border.Opacity>
                                        <StackPanel>
                                            <!-- Attachments stack (images / file rows / tombstones) -->
                                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,4">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6" MaxWidth="480">
                                                            <!-- Loading placeholder -->
                                                            <Border Height="120" CornerRadius="10" Background="#22000000"
                                                                    Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <!-- Image tile -->
                                                            <Border CornerRadius="10" ClipToBounds="True" Cursor="Hand"
                                                                    Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    MouseLeftButtonUp="OnAttachmentImageClick">
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                                           MaxHeight="420" MaxWidth="480"/>
                                                                    <Ellipse Width="36" Height="36" Stroke="#FF2AABEE" StrokeThickness="3"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Visibility="{Binding DataContext.ShowUploadProgress, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>
                                                            <!-- File row -->
                                                            <DockPanel Visibility="{Binding ShowFileRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8"
                                                                        Background="#33000000" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding TypeGlyph}" FontSize="18"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button DockPanel.Dock="Right" Content="Download" Margin="8,0,0,0"
                                                                        Padding="4,0" VerticalAlignment="Top"
                                                                        Foreground="#FF2AABEE" Background="Transparent" BorderThickness="0"
                                                                        Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ChatBubbleTextBrush}"/>
                                                                    <TextBlock Text="{Binding SizeLabel}" FontSize="11"
                                                                               Foreground="{DynamicResource ChatBubbleTimeBrush}"
                                                                               Visibility="{Binding ShowSize, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <!-- Tombstone -->
                                                            <DockPanel Visibility="{Binding ShowTombstone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0">
                                                                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource ChatBubbleTimeBrush}"
                                                                               StrokeThickness="1" StrokeDashArray="2 2" Fill="Transparent"/>
                                                                    <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource ChatBubbleTimeBrush}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="∅"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsNoAccessTombstone}" Value="True">
                                                                                        <Setter Property="Text" Value="🔒"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                                <TextBlock Text="{Binding TombstoneText}" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource ChatBubbleTimeBrush}" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ChatBubbleTextBrush}"
                                                       Visibility="{Binding ShowCaptionText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <!-- M8 entity link unfurl cards -->
                                            <ItemsControl ItemsSource="{Binding UnfurlCards}" Margin="0,6,0,0">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnfurlCards}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="8" Cursor="Hand"
                                                                BorderThickness="1" BorderBrush="{DynamicResource ChatBubbleTimeBrush}"
                                                                Background="Transparent"
                                                                MouseLeftButtonUp="OnUnfurlCardClick"
                                                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6"
                                                                        Background="#22000000" Margin="0,0,10,0">
                                                                    <Grid>
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        <TextBlock Text="{Binding TypeGlyph}" FontSize="16"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ChatBubbleTextBrush}"/>
                                                                    <TextBlock Text="{Binding TypeName}" FontSize="11"
                                                                               Foreground="{DynamicResource ChatBubbleTimeBrush}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding StatusLine}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource ChatBubbleTimeBrush}"
                                                       Visibility="{Binding ShowStatusLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                        Visibility="{Binding ShowFailedActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Content="Retry" Margin="0,0,8,0" Padding="4,0"
                                                        Foreground="#FF2AABEE" Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.RetryFailedSendCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Cancel" Padding="4,0"
                                                        Foreground="{DynamicResource ChatBubbleTimeBrush}" Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.CancelFailedSendCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding TimeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ChatBubbleTimeBrush}"/>
                                                <TextBlock Text="{Binding TicksText}"
                                                           FontSize="11"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Foreground" Value="#FF667781"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowTicks}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeliveryStatus}" Value="Read">
                                                                    <Setter Property="Foreground" Value="#FF53BDEB"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="StickyDateChip"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        Padding="12,4"
                        CornerRadius="12"
                        Background="{DynamicResource ChatDateChipBackgroundBrush}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="StickyDateText"
                               FontSize="12"
                               Foreground="{DynamicResource ChatDateChipForegroundBrush}"/>
                </Border>

                <!-- DnD overlay -->
                <Grid Margin="8" IsHitTestVisible="False"
                      Visibility="{Binding IsDragOverChat, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Rectangle RadiusX="8" RadiusY="8" Fill="#662AABEE"
                               Stroke="#FF2AABEE" StrokeThickness="2" StrokeDashArray="6 4"/>
                    <TextBlock Text="Drop files to attach" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Grid>

                <TextBlock Text="Select a contact to start messaging"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ChatBubbleTimeBrush}"
                           Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <TextBlock Text="Loading…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource ChatBubbleTimeBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsChatLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.Name="Chat loading"/>

                <!-- M9 Media gallery -->
                <Grid Background="{DynamicResource ContentBackground}"
                      Visibility="{Binding IsGalleryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,10">
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28"
                                Command="{Binding CloseMediaGalleryCommand}"
                                Background="Transparent" BorderThickness="0"/>
                        <TextBlock Text="Media" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GalleryItems}" Margin="8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Width="120" Height="120" CornerRadius="6" ClipToBounds="True"
                                            Background="#22000000" Cursor="Hand"
                                            MouseLeftButtonUp="OnGalleryTileClick">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   Visibility="{Binding ShowThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding ShowFileTile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding TypeGlyph}" FontSize="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ExtensionLabel}" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource ChatBubbleTimeBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="{Binding GalleryEmptyHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource ChatBubbleTimeBrush}"
                               Visibility="{Binding ShowGalleryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Lightbox -->
                <Grid Background="#EB000000"
                      Visibility="{Binding IsLightboxOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                      PreviewKeyDown="OnLightboxKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,8">
                        <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                Command="{Binding CloseLightboxCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Download" Margin="0,0,12,0" Padding="10,4"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                Command="{Binding DownloadLightboxCommand}"/>
                        <TextBlock/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Loading…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsLightboxLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding LightboxError}" Foreground="#FFFFCDD2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding LightboxError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Image Source="{Binding LightboxImage}" Stretch="Uniform" Margin="24"
                               Visibility="{Binding LightboxImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource ContentBackground}"
                    BorderBrush="{DynamicResource BorderBrushStandard}" BorderThickness="0,1,0,0"
                    Padding="8,6"
                    Visibility="{Binding SelectedContact, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding PendingAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,0" Padding="6,4" CornerRadius="6"
                                            Background="{DynamicResource ChatDateChipBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="40" Height="40" Margin="0,0,8,0">
                                                <Image Source="{Binding LocalThumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasLocalThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border Background="#33000000" CornerRadius="4"
                                                        Visibility="{Binding HasLocalThumbnail, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                    <TextBlock Text="{Binding TypeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Width="14" Height="14" CornerRadius="2" Background="#FF2AABEE"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Visibility="{Binding ShowSendAsFileBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="📄" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center" MaxWidth="140">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                <TextBlock Text="{Binding SizeLabel}" FontSize="10"
                                                           Foreground="{DynamicResource ChatBubbleTimeBrush}"/>
                                            </StackPanel>
                                            <Button Content="⋮" Margin="4,0,0,0" Padding="4,0" FontSize="14"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip="Send as file"
                                                    Command="{Binding DataContext.ToggleSendAsFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanToggleSendAsFile, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="✕" Margin="2,0,0,0" Padding="2,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.RemovePendingAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="{Binding AttachStatusMessage}" FontSize="12" Margin="0,0,0,4"
                               Foreground="#FFC62828"
                               Visibility="{Binding AttachStatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📎" Grid.Column="0"
                                Margin="0,0,6,0" MinWidth="36" Padding="8,6" ToolTip="Attach"
                                Background="Transparent" BorderThickness="0"
                                Click="OnAttachMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="File…" Command="{Binding AttachFromDiskCommand}"/>
                                    <MenuItem Header="Choose from Cloud…" Command="{Binding ChooseFromCloudCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBox x:Name="ComposerBox"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1" Margin="0,0,8,0" AcceptsReturn="True" MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 Padding="10,6"
                                 PreviewKeyDown="OnComposerPreviewKeyDown"/>
                        <Button Content="Send" Command="{Binding SendCommand}" Grid.Column="2"
                                MinWidth="64" Padding="12,6"
                                Background="#FF2AABEE" Foreground="White" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
